# Base CAN configuration. The template instance name overrides OAS_CAN_INTERFACE.
OAS_CAN_BUS=0
OAS_MAXIMUM_AGE_MS=500

# Loopback-only Viewer state consumer. Leave this path empty to run without Viewer.
OAS_VIEWER_BIN=/usr/lib/oas-gateway/bin/ohayess-viewer
OAS_VIEWER_ADDRESS=127.0.0.1:8080

# Canonical protobuf stream for the Qt/QML HMI bridge. The HMI service owns this FIFO.
OAS_HMI_STREAM=/run/oas-hmi/vehicle-state

# Gateway restart recovery: 1, 2, 4, then at most 5 seconds.
OAS_RECONNECT_INITIAL_BACKOFF_SECONDS=1
OAS_RECONNECT_MAX_BACKOFF_SECONDS=5
OAS_RECONNECT_STABLE_SECONDS=30
